<?xml version="1.0" encoding="utf-8"?>
<!-- Großer Start: a big, simple home screen (clock, battery, family tiles, WhatsApp). The screen is web/index.html,
     shipped inside the app; this is one activity that is the phone's Home app once chosen. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="cc.polychrome.bighome"
    android:versionCode="11"
    android:versionName="1.10.0">

    <!-- Android 7 and newer: covers the older Samsung phones -->
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="35" />
    <!-- a tap on "Anrufen" calls straight away (asked for in the settings; without it the dialer opens first) -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- names, numbers and photos when adding a person from the contacts -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- the "Deinstallieren" button in the settings -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Wecker and Kurzzeitwecker: set in the phone's own clock app -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- updates from the app's GitHub releases, installed quietly while the screen is off -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- "Das Foto auch als Hintergrund des Handys setzen" -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <!-- all optional, each asked for only when switched on in the settings:
         badges (missed calls), Erweiterte Betreuung (SMS to the family, the place for SOS), reminders (notifications),
         Lupe (camera), Bilderrahmen (photos), Großer Anruf-Bildschirm (the call app) -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- "WhatsApp-Anrufe groß anzeigen": the ringing screen over other apps, and the big "Auflegen" during the call -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <!-- what the app may see on Android 11+: WhatsApp, the apps that can go on the home screen, the voice for reading aloud -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="false"
        android:hardwareAccelerated="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale">
            <!-- the Home app -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- and an icon in the app list, for the first setup -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- reminders and care: one alarm for the next thing due, set again after a restart -->
        <receiver android:name=".Care$Alarm" android:exported="false" />
        <receiver android:name=".Care$Boot" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- reads notifications (only once allowed in Android's settings): WhatsApp badges, reading messages aloud -->
        <service android:name=".Notes" android:label="Großer Start" android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter><action android:name="android.service.notification.NotificationListenerService" /></intent-filter>
        </service>

        <!-- Großer Anruf-Bildschirm: what Android needs from a call app (only used once chosen as the call app) -->
        <service android:name=".Phone$Service" android:exported="true" android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data android:name="android.telecom.IN_CALL_SERVICE_UI" android:value="true" />
            <intent-filter><action android:name="android.telecom.InCallService" /></intent-filter>
        </service>
        <activity android:name=".Phone$Screen" android:exported="false" android:launchMode="singleInstance" android:excludeFromRecents="true"
            android:taskAffinity="cc.polychrome.bighome.call" android:screenOrientation="portrait" android:theme="@style/CallTheme"
            android:showWhenLocked="true" android:turnScreenOn="true" />
        <!-- a ringing WhatsApp call, big (only once "WhatsApp-Anrufe groß anzeigen" is on) -->
        <activity android:name=".WhatsApp$Ring" android:exported="false" android:launchMode="singleInstance" android:excludeFromRecents="true"
            android:taskAffinity="cc.polychrome.bighome.wacall" android:screenOrientation="portrait" android:theme="@style/CallTheme"
            android:showWhenLocked="true" android:turnScreenOn="true" />
        <activity android:name=".Phone$Dial" android:exported="true" android:label="Wählen" android:theme="@style/CallTheme"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>
    </application>
</manifest>

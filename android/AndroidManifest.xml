<?xml version="1.0" encoding="utf-8"?>
<!-- Großer Start: a big, simple home screen (clock, battery, family tiles, WhatsApp). The screen is web/index.html,
     shipped inside the app; this is one activity that is the phone's Home app once chosen. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="cc.polychrome.bighome"
    android:versionCode="8"
    android:versionName="1.7.0">

    <!-- Android 7 and newer: covers the older Samsung phones -->
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="35" />
    <!-- a tap on "Anrufen" calls straight away (asked for in the settings; without it the dialer opens first) -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- names, numbers and photos when adding a person from the contacts -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- the "Deinstallieren" button in the settings -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- updates from the app's GitHub releases, installed quietly while the screen is off -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- "Das Foto auch als Hintergrund des Handys setzen" -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <!-- what the app may see on Android 11+: WhatsApp, the apps that can go on the home screen, the voice for reading aloud -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="false"
        android:hardwareAccelerated="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale">
            <!-- the Home app -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- and an icon in the app list, for the first setup -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
